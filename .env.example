# Copy this file to .env and adjust values as needed.
# `docker compose` automatically reads variables from .env.

# Application
APP_ENV=dev
APP_SECRET=changeme
APP_URL=http://localhost:8000
APP_PORT=8000
VITE_PORT=5173

# PostgreSQL database
POSTGRES_DB=hr_portal
POSTGRES_USER=hr_portal
POSTGRES_PASSWORD=hr_portal
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hr_portal:hr_portal@postgres:5432/hr_portal?serverVersion=16&charset=utf8

# CORS - origin(s) allowed to call the API (regex), e.g. the Vite dev server
CORS_ALLOW_ORIGIN=^https?://localhost:5173$

# JWT (lexik/jwt-authentication-bundle)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme
JWT_TOKEN_TTL=3600
