<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 11px;
            color: #000;
        }
        .header {
            width: 100%;
            margin-bottom: 16px;
        }
        .header .employer {
            float: left;
            width: 60%;
        }
        .header .place-date {
            float: right;
            width: 35%;
            text-align: right;
        }
        .clear {
            clear: both;
        }
        .title {
            text-align: center;
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            margin: 24px 0 16px;
        }
        .info {
            margin-bottom: 8px;
        }
        .info-label {
            font-weight: bold;
        }
        .section-title {
            font-weight: bold;
            margin-top: 12px;
            margin-bottom: 4px;
        }
        table.factors {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
        }
        table.factors th,
        table.factors td {
            border: 1px solid #000;
            padding: 3px 5px;
            text-align: left;
            font-size: 10px;
        }
        table.factors th {
            background-color: #eee;
        }
        .no-factors {
            margin: 0 0 8px;
            font-style: italic;
        }
        .total {
            margin-top: 16px;
            font-weight: bold;
        }
        .signature {
            margin-top: 60px;
            text-align: right;
        }
        .signature-line {
            display: inline-block;
            width: 260px;
            border-top: 1px solid #000;
            padding-top: 4px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="employer">
            <strong>{{ company.name }}</strong><br>
            {{ company.street }}<br>
            {{ company.postalCode }} {{ company.city }}<br>
            NIP: {{ company.nip }}
        </div>
        <div class="place-date">
            {{ referral.issuePlace }}, {{ referral.issueDate|date('d.m.Y') }}
        </div>
        <div class="clear"></div>
    </div>

    <div class="title">
        Skierowanie na badania lekarskie ({{ examinationTypeLabel }})
    </div>

    <div class="info">
        <span class="info-label">Imię i nazwisko:</span> {{ employee.firstName }} {{ employee.lastName }}<br>
        <span class="info-label">PESEL:</span> {{ employee.pesel }}<br>
        <span class="info-label">Adres:</span> {{ employee.address }}
    </div>

    <div class="info">
        <span class="info-label">Stanowisko pracy:</span> {{ referral.jobPosition }}
    </div>

    <div class="info">
        <div class="info-label">Opis warunków pracy / zakres czynności:</div>
        <div style="white-space: pre-wrap;">{{ referral.jobDescription }}</div>
    </div>

    <div class="info">
        <div class="info-label">Informacje o czynnikach szkodliwych, niebezpiecznych lub uciążliwych dla zdrowia na stanowisku pracy:</div>
    </div>

    {% for category in categories %}
        <div class="section-title">{{ category.code }}. {{ category.name }}</div>
        {% if category.factors|length > 0 %}
            <table class="factors">
                <thead>
                    <tr>
                        <th>Czynnik</th>
                        <th>Wielkość narażenia / wyniki pomiarów</th>
                    </tr>
                </thead>
                <tbody>
                    {% for factor in category.factors %}
                        <tr>
                            <td>{{ factor.name }}</td>
                            <td>{{ factor.exposureDetails }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="no-factors">Nie wskazano czynników z tej grupy.</p>
        {% endif %}
    {% endfor %}

    <div class="total">
        Łączna liczba wskazanych czynników: {{ totalFactors }}
    </div>

    <div class="signature">
        <div class="signature-line">podpis i pieczątka osoby kierującej na badania</div>
    </div>
</body>
</html>
